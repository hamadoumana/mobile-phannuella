# Backend local (ApiTailorManagement lance via `dotnet run`, port 5001) et
# Keycloak local (voir Keycloak/, port 8081) :
# - Emulateur Android : 10.0.2.2 (alias vers le localhost de la machine hote)
# - Web/Windows desktop : localhost fonctionne directement
# - Telephone physique : IP locale de la machine (ex: 192.168.x.x)
API_BASE_URL=http://10.0.2.2:5001/api/v1
KEYCLOAK_BASE_URL=http://10.0.2.2:8081
KEYCLOAK_REALM=tailorshop
KEYCLOAK_CLIENT_ID=tailorshop-mobile
